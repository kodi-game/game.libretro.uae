msgctxt "#30458"
msgid ""
"Frames in a button cycle.\n"
"- '2' = 1 frame down, 1 frame up\n"
"- '4' = 2 frames down, 2 frames up\n"
"- '6' = 3 frames down, 3 frames up\n"
"etc."
